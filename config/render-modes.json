{
  "$schema": "reel-pipeline.render-modes.v1",
  "modes": [
    {
      "id": "mock",
      "provider": "mock",
      "surface": "video-brief",
      "category": "local",
      "description": "No-dependency placeholder renderer for tests and dry runs.",
      "smoke": {
        "type": "renderFixture"
      }
    },
    {
      "id": "html-composition",
      "aliases": [
        "html",
        "web-composition"
      ],
      "provider": "html-composition",
      "surface": "video-brief",
      "category": "local",
      "description": "Exports HTML/CSS preview artifacts, timeline JSON, and word-level captions.",
      "smoke": {
        "type": "renderFixture"
      }
    },
    {
      "id": "night-out-carousel",
      "provider": "night-out-carousel",
      "surface": "faceless-workflow",
      "category": "local-asset",
      "description": "Builds a bouncy themed-image Night Out reel with an original procedural funk bed.",
      "requires": [
        "approved fleet.night-out-assets.v1 manifest",
        "Chrome",
        "ffmpeg"
      ],
      "smoke": {
        "type": "renderFixture"
      }
    },
    {
      "id": "ascii",
      "aliases": [
        "ascii-animation",
        "ascii-fable",
        "askai"
      ],
      "provider": "ascii-animation",
      "surface": "video-brief",
      "category": "local",
      "description": "Generates stylized ASCII/pixel interlude MP4s with local tools.",
      "smoke": {
        "type": "renderFixture"
      }
    },
    {
      "id": "blender",
      "provider": "blender",
      "surface": "video-brief",
      "category": "local-asset",
      "description": "Renders validated literal-scene manifests through a safe headless Blender 5.2 runtime.",
      "requires": [
        "Blender 5.2.x (`brew install --cask blender`)"
      ],
      "smoke": {
        "type": "command",
        "command": "node",
        "args": [
          "-e",
          "import('./src/adapters/blender.js').then(async m => { const r = await m.probeBlender(); console.log(JSON.stringify(r)); process.exit(r.ready ? 0 : 1); })"
        ],
        "hint": "Install Blender 5.2.x to enable real literal-scene rendering."
      }
    },
    {
      "id": "grok-video",
      "aliases": [
        "grok",
        "grok-videos"
      ],
      "provider": "grok-video",
      "surface": "video-brief",
      "category": "local-asset",
      "description": "Copies approved local Grok/Imagine MP4 exports into the standard artifact flow.",
      "smoke": {
        "type": "grokFixture"
      }
    },
    {
      "id": "render-pro",
      "aliases": [
        "renderpro"
      ],
      "provider": "render-pro",
      "surface": "worker-reel-id",
      "category": "production",
      "description": "Canonical production renderer for approved Worker reel ids.",
      "smoke": {
        "type": "command",
        "command": "node",
        "args": [
          "--check",
          "content-factory/scripts/render-pro.js"
        ],
        "hint": "Live render-pro needs Worker/R2/Chrome/ffmpeg/voice environment and real reel ids."
      }
    },
    {
      "id": "kokoro",
      "provider": "kokoro",
      "surface": "faceless-workflow",
      "category": "local",
      "aliases": [
        "kokoro-compose"
      ],
      "description": "Fully local faceless renderer: Kokoro-82M narration + Pexels b-roll + FFmpeg compose.",
      "requires": [
        "npm run setup:kokoro (one-time ~340MB model download)",
        "PEXELS_API_KEY"
      ],
      "smoke": {
        "type": "command",
        "command": "node",
        "args": [
          "-e",
          "import('./src/adapters/kokoro.js').then(m => process.exit(m.isKokoroReady() ? 0 : 1))"
        ],
        "hint": "run `npm run setup:kokoro` to install the local Kokoro model"
      }
    },
    {
      "id": "brand-video",
      "provider": "brand-video-local",
      "surface": "content-package",
      "category": "local",
      "description": "Source-backed brand motion graphics with local Kokoro narration, Chromium frames, and FFmpeg composition.",
      "requires": [
        "approved fleet.content-package.v1",
        "npm run setup:kokoro",
        "Playwright Chromium (`npx playwright install chromium`)",
        "ffmpeg"
      ],
      "smoke": {
        "type": "command",
        "command": "npm",
        "args": ["run", "render:package", "--", "--file", "test/fixtures/approved-content-package.json", "--out", "tmp/brand-video-smoke"]
      }
    }
  ]
}
