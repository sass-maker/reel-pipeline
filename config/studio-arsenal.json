{
  "$schema": "fleet.studio-arsenal.v1",
  "version": 1,
  "owners": ["Marketing Studio", "Brand Reel", "Forge", "Editorial"],
  "channels": ["instagram_reels", "youtube_shorts"],
  "qualityTiers": ["draft", "standard", "high"],
  "specializedRuntimes": [
    { "id": "threejs", "owner": "Editorial", "execution": "external-step" },
    { "id": "forge", "owner": "Forge", "execution": "external-step" },
    { "id": "ltx", "owner": "Forge", "execution": "external-step" },
    { "id": "editorial", "owner": "Editorial", "execution": "external-step" },
    { "id": "brand-reel", "owner": "Brand Reel", "execution": "external-step" },
    { "id": "lyric-canvas", "owner": "Marketing Studio", "execution": "local" }
  ],
  "spendClasses": {
    "none": {
      "label": "No API spend",
      "note": "Runs through a repository-owned local composition path."
    },
    "local-compute": {
      "label": "Local compute",
      "note": "No generation API charge; uses this machine and installed models or applications."
    },
    "external-service": {
      "label": "External service",
      "note": "Execution belongs to another Fleet surface or a separately running service."
    },
    "paid-api": {
      "label": "Paid API",
      "note": "May consume provider credits; Studio never invents a dollar estimate."
    }
  },
  "guardrails": [
    "Arsenal discovery is read-only and grants no execution permission.",
    "Saving a plan never starts a render.",
    "Rendering requires explicit confirmation or a versioned automation policy.",
    "Source rights, quality evidence, and stable media remain fail-closed gates.",
    "Postiz alone owns social review, scheduling, publishing, and provider state.",
    "Immediate publication and direct social-provider calls are prohibited."
  ],
  "agentWorkflow": [
    { "id": "discover", "method": "GET", "endpoint": "/studio/arsenal", "sideEffect": "none", "confirmationRequired": false },
    { "id": "plan", "method": "POST", "endpoint": "/studio/production-plans", "sideEffect": "local-write", "confirmationRequired": true },
    { "id": "execute", "method": "POST", "endpoint": "/studio/briefs/{briefId}/execute", "sideEffect": "local-render", "confirmationRequired": true },
    { "id": "review", "method": "GET", "endpoint": "/studio/productions", "sideEffect": "none", "confirmationRequired": false },
    { "id": "prepare-distribution", "method": "POST", "endpoint": "/studio/briefs/{briefId}/prepare-distribution", "sideEffect": "local-write", "confirmationRequired": true },
    { "id": "create-postiz-draft", "method": "POST", "endpoint": "/studio/briefs/{briefId}/create-postiz-draft", "sideEffect": "network-write", "confirmationRequired": true },
    { "id": "schedule-postiz", "method": "POST", "endpoint": "/studio/briefs/{briefId}/schedule-postiz", "sideEffect": "network-write", "confirmationRequired": true }
  ],
  "capabilities": [
    {
      "id": "faceless",
      "name": "Faceless lesson",
      "owner": "Marketing Studio",
      "description": "Script, voice, captions, b-roll direction, render, and quality evidence.",
      "required": ["title"],
      "action": { "kind": "execute", "label": "Create video" }
    },
    {
      "id": "brand-reel",
      "name": "Brand reel",
      "owner": "Brand Reel",
      "description": "Turn a real product page into a short proof-led vertical reel.",
      "required": ["projectSlug", "sourceEvidence.canonicalUrl"],
      "action": { "kind": "continue", "label": "Continue in Brand Reel", "href": "/" }
    },
    {
      "id": "guided-app-demo",
      "name": "Guided app demo",
      "owner": "Forge",
      "description": "Record a real app with optional synchronized presenter camera and microphone.",
      "required": ["projectSlug", "sourceEvidence.canonicalUrl", "sourceEvidence.rightsStatus"],
      "action": { "kind": "continue", "label": "Continue in Forge", "href": "https://reels.sassmaker.com/forge" }
    },
    {
      "id": "coherent-film",
      "name": "Coherent film",
      "owner": "Forge",
      "description": "Experiment with generated shots through a versioned Film style; publication evidence is checked later.",
      "required": ["creativeDirection"],
      "action": { "kind": "continue", "label": "Continue in Forge", "href": "https://reels.sassmaker.com/forge" }
    },
    {
      "id": "podcast-short",
      "name": "Podcast short",
      "owner": "Editorial",
      "description": "Select and render a source-faithful clip from transcript and exact source timing.",
      "required": ["sourceEvidence.canonicalUrl", "sourceEvidence.rightsStatus"],
      "action": { "kind": "continue", "label": "Open podcast editor", "href": "http://127.0.0.1:8765" }
    },
    {
      "id": "lyric-video",
      "name": "Literal lyric video",
      "owner": "Marketing Studio",
      "description": "Synchronize cleared audio and timed lyrics with literal scenes and optional Blender visuals.",
      "required": ["title"],
      "action": { "kind": "execute", "label": "Create lyric video" }
    }
  ],
  "recipes": [
    {
      "id": "image-slideshow",
      "name": "Image slideshow",
      "group": "Fast local",
      "kind": "faceless",
      "engine": "html-composition",
      "delivery": "final-video",
      "outputStyle": "Animated image-card slideshow",
      "owner": "Marketing Studio",
      "spend": "none",
      "runtime": "HTML / Canvas",
      "description": "Turn the idea into a sequence of readable visual scenes with distinct composition and motion art directions.",
      "defaults": { "durationSeconds": 30, "qualityTier": "standard", "variantCount": 1 },
      "options": [{ "id": "visualStyle", "label": "Visual style", "type": "select", "choices": ["cinematic-slideshow", "editorial-cutout", "filmstrip", "split-frame", "polaroid-stack", "soft-parallax"], "default": "cinematic-slideshow" }]
    },
    {
      "id": "web-motion",
      "name": "Web motion",
      "group": "Fast local",
      "kind": "faceless",
      "engine": "html-composition",
      "delivery": "final-video",
      "outputStyle": "Kinetic HTML / Canvas composition",
      "owner": "Marketing Studio",
      "spend": "none",
      "runtime": "HTML / Canvas",
      "description": "Build a browser-native animated composition with type, cards, meters, and timed scenes.",
      "defaults": { "durationSeconds": 30, "qualityTier": "standard", "variantCount": 1 },
      "options": [{ "id": "visualStyle", "label": "Visual style", "type": "select", "choices": ["kinetic-type", "editorial-grid", "data-pulse", "modular-cards", "diagram-flow", "minimal-statement"], "default": "kinetic-type" }]
    },
    {
      "id": "ascii-story",
      "name": "ASCII animation",
      "group": "Fast local",
      "kind": "faceless",
      "engine": "ascii",
      "delivery": "final-video",
      "outputStyle": "Authored ASCII / pixel animation",
      "owner": "Marketing Studio",
      "spend": "local-compute",
      "runtime": "Browser frames + FFmpeg",
      "description": "Render a stylized vertical MP4 from local ASCII plates, motion, captions, and generated tone audio.",
      "defaults": { "durationSeconds": 12, "qualityTier": "standard", "variantCount": 1 },
      "options": [{ "id": "palette", "label": "Palette", "type": "select", "choices": ["amber", "mono", "terminal", "cobalt", "magenta", "paper"], "default": "amber" }]
    },
    {
      "id": "product-proof",
      "name": "Product proof reel",
      "group": "Product proof",
      "kind": "brand-reel",
      "engine": "brand-reel",
      "delivery": "continuation",
      "outputStyle": "Source-backed product reel",
      "owner": "Brand Reel",
      "spend": "external-service",
      "runtime": "Brand Reel / Remotion",
      "description": "Use real product evidence and the dedicated Brand Reel review path.",
      "requirements": ["canonical source URL"],
      "action": { "kind": "continue", "label": "Continue in Brand Reel", "href": "/" },
      "defaults": { "durationSeconds": 30, "qualityTier": "high", "variantCount": 2 },
      "options": [{ "id": "proofStyle", "label": "Proof style", "type": "select", "choices": ["before-after", "mini-demo", "changelog"], "default": "mini-demo" }]
    },
    {
      "id": "local-voice-film",
      "name": "Local narrated video",
      "group": "Narrated",
      "kind": "faceless",
      "engine": "kokoro",
      "delivery": "final-video",
      "outputStyle": "Local voice, b-roll, and captions",
      "owner": "Marketing Studio",
      "spend": "local-compute",
      "runtime": "Kokoro + FFmpeg",
      "description": "Use the local Kokoro voice model and existing composition path without a voice API.",
      "requirements": ["installed Kokoro model", "configured b-roll source"],
      "readiness": "kokoro",
      "defaults": { "durationSeconds": 45, "qualityTier": "high", "variantCount": 1 },
      "options": [{ "id": "voice", "label": "Voice", "type": "select", "choices": ["af_heart", "am_adam"], "default": "af_heart" }]
    },
    {
      "id": "grok-asset-film",
      "name": "Grok asset film",
      "group": "Generative and 3D",
      "kind": "faceless",
      "engine": "grok-video",
      "delivery": "final-video",
      "outputStyle": "Approved Grok / Imagine video asset",
      "owner": "Marketing Studio",
      "spend": "paid-api",
      "runtime": "Grok export + local artifact flow",
      "description": "Use an already approved local Grok video export; this Studio does not call Grok or import credentials.",
      "requirements": ["approved local Grok MP4"],
      "readiness": "grok-asset",
      "defaults": { "durationSeconds": 15, "qualityTier": "high", "variantCount": 1 },
      "options": [{ "id": "approvedAssetPath", "label": "Approved local MP4 path", "type": "text", "placeholder": "Absolute path to an operator-approved .mp4", "default": "" }]
    },
    {
      "id": "blender-film",
      "name": "Blender literal scenes",
      "group": "Generative and 3D",
      "kind": "faceless",
      "engine": "blender",
      "delivery": "final-video",
      "outputStyle": "Rendered 3D scene plates",
      "owner": "Marketing Studio",
      "spend": "local-compute",
      "runtime": "Blender 5.2",
      "description": "Build safe scene manifests across eight materially distinct Blender art directions and compose them locally.",
      "requirements": ["Blender 5.2.x"],
      "readiness": "blender",
      "defaults": { "durationSeconds": 20, "qualityTier": "high", "variantCount": 1 },
      "options": [{ "id": "visualStyle", "label": "Visual style", "type": "select", "choices": ["cosmic-shrine", "brutalist-monument", "glass-studio", "low-poly-valley", "organic-bloom", "kinetic-sculpture", "neon-tunnel", "paper-diorama"], "default": "cosmic-shrine" }]
    },
    {
      "id": "threejs-scene",
      "name": "Three.js scene",
      "group": "Generative and 3D",
      "kind": "coherent-film",
      "engine": "threejs",
      "delivery": "continuation",
      "outputStyle": "Interactive WebGL scene",
      "owner": "Editorial",
      "spend": "local-compute",
      "runtime": "Editorial Visual Lab / Three.js",
      "description": "Continue into the existing Three.js Visual Lab instead of pretending Studio has a second WebGL renderer.",
      "action": { "kind": "continue", "label": "Open Three.js Visual Lab", "href": "http://127.0.0.1:8765" },
      "defaults": { "durationSeconds": 20, "qualityTier": "high", "variantCount": 1 },
      "options": [{ "id": "sceneStyle", "label": "Scene style", "type": "select", "choices": ["toon", "diagram", "atmospheric"], "default": "toon" }]
    },
    {
      "id": "guided-app-demo",
      "name": "Guided app demo",
      "group": "Product proof",
      "kind": "guided-app-demo",
      "engine": "forge",
      "delivery": "continuation",
      "outputStyle": "Real app capture with optional presenter",
      "owner": "Forge",
      "spend": "external-service",
      "runtime": "Local Video Forge",
      "description": "Record real product behavior and optional synchronized presenter footage in Forge.",
      "requirements": ["canonical source URL", "approved source rights"],
      "action": { "kind": "continue", "label": "Continue in Forge", "href": "https://reels.sassmaker.com/forge" },
      "defaults": { "durationSeconds": 45, "qualityTier": "high", "variantCount": 1 },
      "options": [{ "id": "presenter", "label": "Presenter", "type": "select", "choices": ["none", "camera", "camera-and-mic"], "default": "none" }]
    },
    {
      "id": "coherent-local-film",
      "name": "Coherent local-model film",
      "group": "Generative and 3D",
      "kind": "coherent-film",
      "engine": "ltx",
      "delivery": "final-video",
      "outputStyle": "Coherent generated film",
      "owner": "Marketing Studio",
      "spend": "local-compute",
      "runtime": "Registered local video model",
      "description": "Plan and render private generated-shot experiments through the exact selected local-model executor.",
      "requirements": ["ready local model"],
      "supports": { "themePacks": true, "generationMode": "image-to-video", "modelProfiles": true },
      "action": { "kind": "execute", "label": "Create local video", "href": null },
      "defaults": { "durationSeconds": 20, "qualityTier": "high", "variantCount": 2 },
      "options": [{ "id": "continuity", "label": "Continuity", "type": "select", "choices": ["strict", "balanced", "experimental"], "default": "strict" }]
    },
    {
      "id": "podcast-short",
      "name": "Podcast short",
      "group": "Source formats",
      "kind": "podcast-short",
      "engine": "editorial",
      "delivery": "continuation",
      "outputStyle": "Source-faithful speaker clip",
      "owner": "Editorial",
      "spend": "external-service",
      "runtime": "Editorial",
      "description": "Choose exact transcript timing and preserve the source speaker and credits in Editorial.",
      "requirements": ["canonical source URL", "approved source rights"],
      "action": { "kind": "continue", "label": "Open podcast editor", "href": "http://127.0.0.1:8765" },
      "defaults": { "durationSeconds": 45, "qualityTier": "high", "variantCount": 1 },
      "options": [{ "id": "layout", "label": "Layout", "type": "select", "choices": ["speaker-first", "captions-first", "split"], "default": "speaker-first" }]
    },
    {
      "id": "literal-lyric-video",
      "name": "Literal lyric video",
      "group": "Source formats",
      "kind": "lyric-video",
      "engine": "lyric-canvas",
      "delivery": "final-video",
      "outputStyle": "Timed literal lyric scenes",
      "owner": "Marketing Studio",
      "spend": "local-compute",
      "runtime": "Lyric compositor + optional Blender",
      "description": "Synchronize operator-supplied audio and timed lyrics with literal scenes and explicit rights evidence.",
      "requirements": ["local audio", "timed lyrics", "composition rights", "master rights", "attribution"],
      "readiness": "lyric",
      "defaults": { "durationSeconds": 30, "qualityTier": "high", "variantCount": 1 },
      "options": [
        { "id": "visualStyle", "label": "Visual style", "type": "select", "choices": ["literal-cinematic", "kinetic-type"], "default": "literal-cinematic" },
        { "id": "useBlender", "label": "Generate Blender plates", "type": "boolean", "default": false }
      ]
    },
    {
      "id": "night-out-carousel",
      "name": "Night Out carousel",
      "group": "Fast local",
      "kind": "faceless",
      "engine": "night-out-carousel",
      "delivery": "final-video",
      "outputStyle": "Bouncy themed-image party carousel",
      "owner": "Marketing Studio",
      "spend": "local-compute",
      "runtime": "WAI image generation + Chrome + FFmpeg",
      "description": "Prompt four local themed party cards, then bounce through them over an original funk bed. Approved image manifests remain supported.",
      "requirements": [],
      "supports": { "themePacks": true, "generationMode": "image-to-reel", "modelProfiles": true },
      "defaults": { "durationSeconds": 13, "qualityTier": "high", "variantCount": 1 },
      "options": []
    }
  ],
  "tools": [
    { "id": "ideas", "label": "Video ideas", "category": "ideation", "hint": "Ideas with title, angle, hook, and format for a niche.", "sideEffect": "none", "confirmationRequired": false, "fields": [{ "name": "niche", "label": "Niche", "placeholder": "home espresso", "required": true }, { "name": "count", "label": "Count", "type": "number", "value": "10" }] },
    { "id": "niche", "label": "Niche explorer", "category": "ideation", "hint": "Sub-niches with audience and competition estimates.", "sideEffect": "none", "confirmationRequired": false, "fields": [{ "name": "niche", "label": "Niche", "placeholder": "home espresso", "required": true }] },
    { "id": "channel", "label": "Channel names", "category": "ideation", "hint": "Brandable channel name suggestions.", "sideEffect": "none", "confirmationRequired": false, "fields": [{ "name": "niche", "label": "Niche", "placeholder": "home espresso", "required": true }, { "name": "count", "label": "Count", "type": "number", "value": "8" }] },
    { "id": "titles", "label": "Titles", "category": "metadata", "hint": "Title variants under 100 characters.", "sideEffect": "none", "confirmationRequired": false, "fields": [{ "name": "topic", "label": "Topic", "placeholder": "latte art basics", "required": true }, { "name": "count", "label": "Count", "type": "number", "value": "5" }] },
    { "id": "description", "label": "Description", "category": "metadata", "hint": "Hook, summary, chapters block, CTA, hashtags.", "sideEffect": "none", "confirmationRequired": false, "fields": [{ "name": "topic", "label": "Topic", "placeholder": "latte art basics", "required": true }, { "name": "hook", "label": "Hook (optional)" }, { "name": "cta", "label": "CTA (optional)" }] },
    { "id": "tags", "label": "Tags", "category": "metadata", "hint": "Deduped tags fit to the 500-char budget.", "sideEffect": "none", "confirmationRequired": false, "fields": [{ "name": "topic", "label": "Topic", "placeholder": "latte art basics", "required": true }, { "name": "niche", "label": "Niche (optional)" }] },
    { "id": "organize", "label": "Tag organizer", "category": "metadata", "hint": "Clean and rank an existing comma-separated tag list.", "sideEffect": "none", "confirmationRequired": false, "fields": [{ "name": "tags", "label": "Tags (comma separated)", "type": "textarea", "required": true }] },
    { "id": "script", "label": "Script", "category": "writing", "hint": "Scene-structured script, 30s to 20min. Paste an article to adapt it.", "sideEffect": "none", "confirmationRequired": false, "fields": [{ "name": "topic", "label": "Topic" }, { "name": "duration", "label": "Duration (seconds)", "type": "number", "value": "60" }, { "name": "niche", "label": "Niche (optional)" }, { "name": "article", "label": "Article / transcript to adapt (optional)", "type": "textarea" }] },
    { "id": "voice", "label": "Brand voice", "category": "writing", "hint": "Derive a voice profile from a sample transcript.", "sideEffect": "none", "confirmationRequired": false, "fields": [{ "name": "samples", "label": "Sample transcript", "type": "textarea", "required": true }] },
    { "id": "keywords", "label": "Keywords", "category": "research", "hint": "Autocomplete-based keyword research, no API key.", "sideEffect": "network-read", "confirmationRequired": false, "fields": [{ "name": "seed", "label": "Seed keyword", "placeholder": "latte art", "required": true }] },
    { "id": "transcript", "label": "Transcript", "category": "research", "hint": "Fetch public captions for a YouTube URL.", "sideEffect": "network-read", "confirmationRequired": false, "fields": [{ "name": "url", "label": "YouTube URL", "placeholder": "https://youtu.be/…", "required": true }] },
    { "id": "thumbnails", "label": "Thumbnails", "category": "creative", "hint": "Thumbnail concepts: composition, overlay, emotion, colors.", "sideEffect": "none", "confirmationRequired": false, "fields": [{ "name": "topic", "label": "Topic", "placeholder": "latte art basics", "required": true }, { "name": "count", "label": "Count", "type": "number", "value": "3" }] },
    { "id": "faceless", "label": "Faceless run", "category": "production", "hint": "Topic → script → brief → local render. Never posts.", "sideEffect": "local-render", "confirmationRequired": true, "fields": [{ "name": "topic", "label": "Topic", "placeholder": "latte art basics", "required": true }, { "name": "duration", "label": "Duration (seconds)", "type": "number", "value": "60" }, { "name": "niche", "label": "Niche (optional)" }, { "name": "engine", "label": "Engine", "type": "select", "options": ["mock", "kokoro"] }] },
    { "id": "plan", "label": "Factory: plan", "category": "factory", "hint": "Fill the backlog with ideas for a niche (status: new).", "sideEffect": "local-write", "confirmationRequired": true, "fields": [{ "name": "niche", "label": "Niche", "placeholder": "home espresso", "required": true }, { "name": "count", "label": "Count", "type": "number", "value": "10" }] },
    { "id": "produce", "label": "Factory: produce", "category": "factory", "hint": "Render the next N backlog ideas: script → video → quality gate → publish packet.", "sideEffect": "local-render", "confirmationRequired": true, "fields": [{ "name": "count", "label": "How many", "type": "number", "value": "1" }, { "name": "engine", "label": "Engine", "type": "select", "options": ["kokoro", "mock"] }, { "name": "duration", "label": "Duration (seconds)", "type": "number", "value": "60" }] },
    { "id": "save", "label": "Save idea", "category": "factory", "hint": "Add an idea to the manager (statuses: new → scripted → rendered → posted).", "sideEffect": "local-write", "confirmationRequired": true, "fields": [{ "name": "title", "label": "Title", "required": true }, { "name": "niche", "label": "Niche (optional)" }, { "name": "hook", "label": "Hook (optional)" }, { "name": "notes", "label": "Notes (optional)" }] },
    { "id": "status", "label": "Update idea status", "category": "factory", "hint": "Advance a saved idea through the existing lifecycle.", "sideEffect": "local-write", "confirmationRequired": true, "ui": false, "fields": [{ "name": "id", "label": "Idea id", "required": true }, { "name": "to", "label": "Status", "required": true }] }
  ]
}
